  "soraBackgroundTuning": "{"blank":false}",
  "stylePackTuning": "{"pack":{"format":"folia-style","schemaVersion":2,"id":"folia.prism","name":"PRISM — Lyric Atlas","version":"1.0.0","author":"Folia","description":"A kinetic lyric stage: three shot compositions, timed glyphs, orbital geometry and deterministic camera motion.","palette":{"background":"#13151b","primary":"#eee9dd","secondary":"#89918b","accent":"#d8f16f"},"settings":{"accent":"#d8f16f","motion":1},"renderer":{"apiVersion":2,"code":"FoliaStyle.define(function prismRenderer(context) {\\n\\tconst { canvas, settings } = context;\\n\\tconst ctx = canvas.getContext(\\"2d\\");\\n\\tif (!ctx) throw new Error(\\"Canvas 2D unavailable\\");\\n\\tlet scene = {\\n\\t\\ttitle: \\"\\",\\n\\t\\tartist: \\"\\",\\n\\t\\talbum: \\"\\",\\n\\t\\tduration: 0,\\n\\t\\tlines: []\\n\\t};\\n\\tconst clamp = (v) => Math.max(0, Math.min(1, v));\\n\\tconst ease = (v) => 1 - Math.pow(1 - clamp(v), 3);\\n\\tconst ink = \\"#13151b\\", paper = \\"#eee9dd\\", acid = String(settings.accent || \\"#d8f16f\\");\\n\\tlet cacheKey = \\"\\", layout = [], size = 0;\\n\\treturn {\\n\\t\\tupdate(next) {\\n\\t\\t\\tscene = next;\\n\\t\\t\\tcacheKey = \\"\\";\\n\\t\\t},\\n\\t\\trender(f) {\\n\\t\\t\\tconst w = f.width, h = f.height, s = Math.min(w, h), portrait = h > w;\\n\\t\\t\\tconst selected = scene.lines[f.index];\\n\\t\\t\\tconst index = Math.max(0, f.index), kind = index % 3;\\n\\t\\t\\tconst local = f.time - (selected?.start ?? 0), span = Math.max(.1, (selected?.end ?? 6) - (selected?.start ?? 0));\\n\\t\\t\\tconst motion = f.reducedMotion ? 0 : Number(settings.motion ?? 1);\\n\\t\\t\\tconst progress = clamp(local / span), arrive = f.reducedMotion ? 1 : ease((local + .12) / .65);\\n\\t\\t\\tconst t = f.reducedMotion ? 0 : f.time, inverted = kind === 1;\\n\\t\\t\\tconst bg = inverted ? acid : ink, fg = inverted ? ink : paper, highlight = inverted ? \\"#3e5049\\" : acid;\\n\\t\\t\\tctx.setTransform(1, 0, 0, 1, 0, 0);\\n\\t\\t\\tctx.globalAlpha = 1;\\n\\t\\t\\tctx.fillStyle = bg;\\n\\t\\t\\tctx.fillRect(0, 0, w, h);\\n\\t\\t\\t// A persistent architectural grid makes the shot changes read as one visual world.\\n\\t\\t\\tctx.strokeStyle = fg;\\n\\t\\t\\tctx.lineWidth = Math.max(1, s / 800);\\n\\t\\t\\tctx.globalAlpha = .12;\\n\\t\\t\\tfor (let i = 1; i < 8; i++) {\\n\\t\\t\\t\\tctx.beginPath();\\n\\t\\t\\t\\tctx.moveTo(w * i / 8, 0);\\n\\t\\t\\t\\tctx.lineTo(w * i / 8, h);\\n\\t\\t\\t\\tctx.stroke();\\n\\t\\t\\t};\\n\\t\\t\\tfor (let i = 1; i < 5; i++) {\\n\\t\\t\\t\\tctx.beginPath();\\n\\t\\t\\t\\tctx.moveTo(0, h * i / 5);\\n\\t\\t\\t\\tctx.lineTo(w, h * i / 5);\\n\\t\\t\\t\\tctx.stroke();\\n\\t\\t\\t};\\n\\t\\t\\tctx.save();\\n\\t\\t\\tctx.translate(w * (kind === 2 ? .5 : .78), h * .47);\\n\\t\\t\\tctx.rotate((kind === 1 ? -.35 : .3) + Math.sin(t * .16) * .08 * motion);\\n\\t\\t\\tconst radial = s * (.38 + .02 * f.audio * motion);\\n\\t\\t\\tif (kind === 0) {\\n\\t\\t\\t\\tctx.fillStyle = acid;\\n\\t\\t\\t\\tctx.globalAlpha = .92;\\n\\t\\t\\t\\tctx.beginPath();\\n\\t\\t\\t\\tctx.ellipse(0, 0, radial * .62, radial * 1.6, 0, 0, Math.PI * 2);\\n\\t\\t\\t\\tctx.fill();\\n\\t\\t\\t\\tctx.fillStyle = ink;\\n\\t\\t\\t\\tctx.beginPath();\\n\\t\\t\\t\\tctx.ellipse(0, 0, radial * .43, radial * 1.2, 0, 0, Math.PI * 2);\\n\\t\\t\\t\\tctx.fill();\\n\\t\\t\\t\\tctx.strokeStyle = acid;\\n\\t\\t\\t\\tctx.globalAlpha = .35;\\n\\t\\t\\t\\tfor (let i = 0; i < 8; i++) {\\n\\t\\t\\t\\t\\tctx.beginPath();\\n\\t\\t\\t\\t\\tctx.ellipse(0, 0, radial * (.68 + i * .08), radial * (1.65 + i * .1), 0, 0, Math.PI * 2);\\n\\t\\t\\t\\t\\tctx.stroke();\\n\\t\\t\\t\\t}\\n\\t\\t\\t} else if (kind === 1) {\\n\\t\\t\\t\\tctx.globalAlpha = .12;\\n\\t\\t\\t\\tctx.fillStyle = ink;\\n\\t\\t\\t\\tfor (let i = -5; i < 6; i++) ctx.fillRect(i * s * .16 + progress * s * .08 * motion, -h, s * .08, h * 2);\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tctx.globalAlpha = .6;\\n\\t\\t\\t\\tctx.strokeStyle = acid;\\n\\t\\t\\t\\tfor (let i = 0; i < 6; i++) {\\n\\t\\t\\t\\t\\tctx.rotate(.26);\\n\\t\\t\\t\\t\\tctx.beginPath();\\n\\t\\t\\t\\t\\tctx.ellipse(0, 0, radial * 1.4, radial * (.35 + i * .025), 0, 0, Math.PI * 2);\\n\\t\\t\\t\\t\\tctx.stroke();\\n\\t\\t\\t\\t};\\n\\t\\t\\t\\tfor (let i = 0; i < 24; i++) {\\n\\t\\t\\t\\t\\tconst a = i * Math.PI / 12 + t * .1 * motion;\\n\\t\\t\\t\\t\\tctx.fillStyle = i % 3 ? acid : \\"#ff846c\\";\\n\\t\\t\\t\\t\\tctx.fillRect(Math.cos(a) * radial * 1.25, Math.sin(a) * radial * 1.25, s * .006, s * .006);\\n\\t\\t\\t\\t}\\n\\t\\t\\t};\\n\\t\\t\\tctx.restore();\\n\\t\\t\\tctx.globalAlpha = 1;\\n\\t\\t\\t// Oversized type is part of the composition, not a fixed player card.\\n\\t\\t\\tctx.font = \`900 \${s * .55}px \${f.fontFamily}\`;\\n\\t\\t\\tctx.fillStyle = fg;\\n\\t\\t\\tctx.globalAlpha = .06;\\n\\t\\t\\tctx.textAlign = \\"left\\";\\n\\t\\t\\tctx.fillText(String(index + 1).padStart(2, \\"0\\"), w * .025, h * .82);\\n\\t\\t\\tctx.globalAlpha = 1;\\n\\t\\t\\tconst glyphs = selected?.glyphs.length ? selected.glyphs : Array.from(scene.title || \\"PRISM\\").map((text) => ({\\n\\t\\t\\t\\ttext,\\n\\t\\t\\t\\tstart: 0,\\n\\t\\t\\t\\tend: 0\\n\\t\\t\\t}));\\n\\t\\t\\tconst key = [\\n\\t\\t\\t\\tindex,\\n\\t\\t\\t\\tw,\\n\\t\\t\\t\\th,\\n\\t\\t\\t\\tf.fontFamily,\\n\\t\\t\\t\\tf.fontWeight,\\n\\t\\t\\t\\tf.fontScale,\\n\\t\\t\\t\\tf.showText,\\n\\t\\t\\t\\tglyphs.map((g) => g.text).join(\\"\\")\\n\\t\\t\\t].join(\\"|\\");\\n\\t\\t\\tif (cacheKey !== key) {\\n\\t\\t\\t\\tcacheKey = key;\\n\\t\\t\\t\\tconst maxWidth = w * (portrait ? .78 : .78), maxHeight = h * .48;\\n\\t\\t\\t\\tsize = s * (portrait ? .145 : .15) * f.fontScale;\\n\\t\\t\\t\\tfor (let attempt = 0; attempt < 16; attempt++) {\\n\\t\\t\\t\\t\\tctx.font = \`\${f.fontWeight} \${size}px \${f.fontFamily}\`;\\n\\t\\t\\t\\t\\tconst rows = [[]];\\n\\t\\t\\t\\t\\tlet x = 0;\\n\\t\\t\\t\\t\\tfor (const glyph of glyphs.slice(0, 500)) {\\n\\t\\t\\t\\t\\t\\tconst advance = ctx.measureText(glyph.text).width + size * .015;\\n\\t\\t\\t\\t\\t\\tif (x + advance > maxWidth && x > 0 || glyph.text === \\"\\\\n\\") {\\n\\t\\t\\t\\t\\t\\t\\trows.push([]);\\n\\t\\t\\t\\t\\t\\t\\tx = 0;\\n\\t\\t\\t\\t\\t\\t};\\n\\t\\t\\t\\t\\t\\trows[rows.length - 1].push({\\n\\t\\t\\t\\t\\t\\t\\tchar: glyph.text,\\n\\t\\t\\t\\t\\t\\t\\tx,\\n\\t\\t\\t\\t\\t\\t\\ty: 0,\\n\\t\\t\\t\\t\\t\\t\\tstart: glyph.start,\\n\\t\\t\\t\\t\\t\\t\\tend: glyph.end\\n\\t\\t\\t\\t\\t\\t});\\n\\t\\t\\t\\t\\t\\tx += advance;\\n\\t\\t\\t\\t\\t};\\n\\t\\t\\t\\t\\tif (rows.length * size * 1.18 <= maxHeight || attempt === 15) {\\n\\t\\t\\t\\t\\t\\tlayout = rows.flatMap((row, ri) => {\\n\\t\\t\\t\\t\\t\\t\\tconst end = row.at(-1);\\n\\t\\t\\t\\t\\t\\t\\tconst rowWidth = end ? end.x + ctx.measureText(end.char).width : 0;\\n\\t\\t\\t\\t\\t\\t\\treturn row.map((g) => ({\\n\\t\\t\\t\\t\\t\\t\\t\\t...g,\\n\\t\\t\\t\\t\\t\\t\\t\\tx: g.x - rowWidth / 2,\\n\\t\\t\\t\\t\\t\\t\\t\\ty: (ri - (rows.length - 1) / 2) * size * 1.18\\n\\t\\t\\t\\t\\t\\t\\t}));\\n\\t\\t\\t\\t\\t\\t});\\n\\t\\t\\t\\t\\t\\tbreak;\\n\\t\\t\\t\\t\\t};\\n\\t\\t\\t\\t\\tsize *= .86;\\n\\t\\t\\t\\t}\\n\\t\\t\\t};\\n\\t\\t\\tif (f.showText) {\\n\\t\\t\\t\\tctx.save();\\n\\t\\t\\t\\tctx.translate(w * .5, h * .47);\\n\\t\\t\\t\\tctx.rotate((kind === 0 ? -.055 : kind === 2 ? .045 : 0) * motion);\\n\\t\\t\\t\\tctx.translate(0, (1 - arrive) * s * .08 * motion);\\n\\t\\t\\t\\tctx.textAlign = \\"left\\";\\n\\t\\t\\t\\tctx.textBaseline = \\"middle\\";\\n\\t\\t\\t\\tctx.font = \`\${f.fontWeight} \${size}px \${f.fontFamily}\`;\\n\\t\\t\\t\\tfor (let i = 0; i < layout.length; i++) {\\n\\t\\t\\t\\t\\tconst g = layout[i], sung = f.time >= g.start, active = sung && f.time < g.end;\\n\\t\\t\\t\\t\\tconst pop = motion * (active ? Math.sin(clamp((f.time - g.start) / Math.max(.1, g.end - g.start)) * Math.PI) : 0);\\n\\t\\t\\t\\t\\tconst enter = f.reducedMotion ? 1 : ease((local + .22 - i * .012) / .55);\\n\\t\\t\\t\\t\\tctx.save();\\n\\t\\t\\t\\t\\tctx.translate(g.x, g.y + (1 - enter) * size * .7 * motion - pop * size * .06);\\n\\t\\t\\t\\t\\tctx.globalAlpha = selected ? .38 + .62 * enter : 1;\\n\\t\\t\\t\\t\\t// Solid backing keeps singing text legible over the moving geometric field.\\n\\t\\t\\t\\t\\tctx.strokeStyle = bg;\\n\\t\\t\\t\\t\\tctx.lineWidth = size * .09;\\n\\t\\t\\t\\t\\tctx.lineJoin = \\"round\\";\\n\\t\\t\\t\\t\\tctx.strokeText(g.char, 0, 0);\\n\\t\\t\\t\\t\\tctx.fillStyle = active ? highlight : sung ? fg : inverted ? \\"#526735\\" : \\"#89918b\\";\\n\\t\\t\\t\\t\\tctx.fillText(g.char, 0, 0);\\n\\t\\t\\t\\t\\tctx.restore();\\n\\t\\t\\t\\t};\\n\\t\\t\\t\\tctx.restore();\\n\\t\\t\\t};\\n\\t\\t\\tctx.textBaseline = \\"alphabetic\\";\\n\\t\\t\\tctx.textAlign = \\"left\\";\\n\\t\\t\\tctx.globalAlpha = .85;\\n\\t\\t\\tctx.font = \`500 \${s * .014}px \${f.fontFamily}\`;\\n\\t\\t\\tctx.fillStyle = fg;\\n\\t\\t\\tctx.fillText(\\"FOLIA / PRISM\\", w * .045, h * .075);\\n\\t\\t\\tctx.textAlign = \\"right\\";\\n\\t\\t\\tctx.fillText(\`\${String(index + 1).padStart(2, \\"0\\")} / \${String(Math.max(1, scene.lines.length)).padStart(2, \\"0\\")}\`, w * .955, h * .075);\\n\\t\\t\\tctx.textAlign = \\"center\\";\\n\\t\\t\\tctx.font = \`\${f.subtitleFontWeight} \${Math.min(s * .026 * f.fontScale * f.subtitleFontScale, w * .04)}px \${f.subtitleFontFamily}\`;\\n\\t\\t\\tlet subtitle = f.showText ? f.translation : \\"\\";\\n\\t\\t\\twhile (subtitle.length > 1 && ctx.measureText(subtitle).width > w * .84) subtitle = subtitle.slice(0, -2);\\n\\t\\t\\tctx.fillText(subtitle, w * .5, h * .8);\\n\\t\\t\\tctx.font = \`500 \${s * .017}px \${f.fontFamily}\`;\\n\\t\\t\\tctx.fillText(\`\${scene.title}  /  \${scene.artist}\`.slice(0, 100), w * .5, h * .9, w * .84);\\n\\t\\t\\tctx.globalAlpha = .22;\\n\\t\\t\\tctx.fillRect(w * .045, h * .95, w * .91, Math.max(1, s * .002));\\n\\t\\t\\tctx.globalAlpha = 1;\\n\\t\\t\\tctx.fillStyle = highlight;\\n\\t\\t\\tctx.fillRect(w * .045, h * .95, w * .91 * clamp(f.time / Math.max(1, f.duration)), Math.max(2, s * .003));\\n\\t\\t\\tif (context.cover) ctx.drawImage(context.cover, w * .045, h * .83, s * .065,