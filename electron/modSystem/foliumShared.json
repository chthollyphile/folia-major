{
    "version": { "major": 2, "minor": 0 },
    "foliumOneVersion": { "major": 1, "minor": 9 },
    "manifestVersions": [1, 2],
    "sourcesPreview": true,
    "sourceCapabilities": {
        "search": [1],
        "songs": [1],
        "playback.audio": [1],
        "playback.external": [1],
        "playback.surface": [],
        "reports": [1],
        "lyrics": [1],
        "auth": [1],
        "library": [1],
        "catalog": [1],
        "recommendations": [1],
        "explore": [1],
        "mutations": [1],
        "covers": [1],
        "raw": [1]
    },
    "limits": {
        "standard": {
            "netFetch": { "permission": true, "defaultTimeoutMs": 15000, "maxTimeoutMs": 60000, "maxBodyBytes": 5242880 },
            "storage": { "permission": true, "maxBytes": 1048576 },
            "secrets": { "maxBytes": 8192 },
            "start": { "firstScreenMs": 1500, "slowMs": 5000 }
        },
        "source": {
            "netFetch": { "permission": false, "defaultTimeoutMs": 15000, "maxTimeoutMs": null, "maxBodyBytes": null },
            "storage": { "permission": false, "maxBytes": 16777216 },
            "secrets": { "maxBytes": 65536 },
            "start": { "firstScreenMs": 3000, "slowMs": 5000 },
            "unload": { "beforeUnloadMs": 3000, "beforeQuitMs": 3000 }
        }
    },
    "permissions": {
        "filesystem.data": { "guards": ["folium.storage", "api.storage"] },
        "playback.read": { "guards": ["api.runtime.getPlaybackSnapshot"] },
        "playback.control": {
            "guards": [
                "folium.playback.play",
                "folium.playback.pause",
                "folium.playback.toggle",
                "folium.playback.seek",
                "folium.playback.seekToLyricTime",
                "folium.playback.next",
                "folium.playback.previous",
                "folium.playback.playSong",
                "folium.playback.enqueue",
                "folium.playback.shuffleQueue",
                "folium.playback.toggleLike",
                "folium.playback.setVolume",
                "folium.playback.setMuted",
                "folium.playback.setLoopMode",
                "folium.playback.playQueueItem"
            ]
        },
        "playback.queue": { "guards": ["folium.playback.replaceQueue"] },
        "equalizer.control": { "guards": ["folium.equalizer.setMode", "folium.equalizer.applyCurve", "folium.equalizer.releaseCurve"] },
        "visualizer.renderQuality": { "guards": ["folium.visualizer.setRenderQuality"] },
        "visualizer.mode": { "guards": ["folium.visualizer.setMode"] },
        "visualizer.tuning": { "guards": ["folium.visualizer.setTuning"] },
        "visualizer.beatEffects": { "guards": ["folium.visualizer.setBeatEffects"] },
        "visualizer.background": { "guards": ["folium.visualizer.setBackground"] },
        "visualizer.animationIntensity": { "guards": ["folium.visualizer.setAnimationIntensity"] },
        "render.export": { "guards": ["api.render.exportVideo"] },
        "net.fetch": { "guards": ["folium.net.fetch"] },
        "net.embed": { "guards": ["folium.ui.embed"] },
        "stageLayers": { "guards": ["folium.registries.stageLayers"] },
        "platform.netease.read": { "guards": ["folium.experimental.platform.raw.request"] },
        "platform.netease.write": { "guards": ["folium.experimental.platform.raw.request.write"] }
    },
    "experimental": {
        "omniProviders": "omni.providers",
        "omniHooks": "omni.hooks",
        "ponderTargets": "ponder.targets",
        "playerLayout": "player.layout",
        "remoteActions": "remote.actions",
        "platformRaw": "platform.raw"
    },
    "channels": {
        "list": "folia-mods:list",
        "setEnabled": "folia-mods:set-enabled",
        "reload": "folia-mods:reload",
        "rpc": "folia-mods:rpc",
        "storage": "folia-mods:storage",
        "secrets": "folia-mods:secrets",
        "netFetch": "folia-mods:net-fetch",
        "pickFile": "folia-mods:pick-file",
        "restoreFile": "folia-mods:restore-file",
        "releaseFile": "folia-mods:release-file",
        "pushRuntimeSnapshot": "folia-mods:push-runtime-snapshot",
        "exportCancel": "folia-mods:export-cancel",
        "ffmpegStatus": "folia-mods:ffmpeg-status",
        "openDirectory": "folia-mods:open-directory",
        "installZip": "folia-mods:install-zip",
        "storageUsage": "folia-mods:storage-usage",
        "clearCache": "folia-mods:clear-cache",
        "callStats": "folia-mods:call-stats",
        "startSettled": "folia-mods:start-settled",
        "startAlive": "folia-mods:start-alive",
        "sourceStates": "folia-mods:source-states",
        "setSourceState": "folia-mods:set-source-state",
        "sourceData": "folia-mods:source-data",
        "clearSourceData": "folia-mods:clear-source-data",
        "confirmOverride": "folia-mods:confirm-override",
        "assignSourceClaim": "folia-mods:assign-source-claim",
        "sourcesRegistered": "folia-mods:sources-registered",
        "fStateChanged": "folia-mods:state-changed",
        "fExportProgress": "folia-mods:export-progress",
        "fLog": "folia-mods:log",
        "fRpcMessage": "folia-mods:rpc-message",
        "fSecretChanged": "folia-mods:secret-changed",
        "fSourceStatesChanged": "folia-mods:source-states-changed",
        "fSourcesStopping": "folia-mods:sources-stopping"
    }
}
