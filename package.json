{
  "name": "folia-major",
  "productName": "Folia",
  "description": "Lyrics Reimagine",
  "author": {
    "name": "chthollyphile",
    "email": "chthollyphile@users.noreply.github.com"
  },
  "private": true,
  "version": "0.7.0",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:probe": "vite --open /dev-probe.html",
    "build": "npm run build:vercel-api && vite build",
    "build:vercel-api": "tsc -p api-ts/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:unit:watch": "vitest -c vitest.config.ts",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "benchmark:lyrics": "npx tsx test/manual/lyrics_benchmark.ts",
    "manual:lyrics": "npx tsx test/manual/netease_lyrics_cli.ts",
    "audit:lyrics-sources": "npx tsx test/manual/lyric-audit/index.ts",
    "probe:netease-xeapi": "node test/manual/netease_xeapi_probe.cjs",
    "manual:wallpaper-watchdog": "npx tsx test/manual/wallpaper-watchdog-sim.ts",
    "manual:analysis-idle": "node test/manual/analysis_idle_release.mts",
    "manual:visualizer-memory": "node test/manual/visualizer-memory-probe.mjs",
    "stage:client": "vite --open /stage-client.html",
    "dev:electron": "cross-env ELECTRON_DEV=true FOLIA_WINDOWTOLAYER_PATH=build/windowtolayer concurrently -k \"vite\" \"wait-on tcp:3000 && electron .\"",
    "dev:electron:update-preview": "cross-env ELECTRON_DEV=true FOLIA_DEV_UPDATE_PREVIEW=true FOLIA_WINDOWTOLAYER_PATH=build/windowtolayer concurrently -k \"vite\" \"wait-on tcp:3000 && electron .\"",
    "dev:electron:wallpaper": "npm run build:windowtolayer && npm run dev:electron",
    "dev:electron:dist": "cross-env ELECTRON_DEV=false ELECTRON=true ELECTRON_LINUX_PACKAGED_GRAPHICS=true FOLIA_WINDOWTOLAYER_PATH=build/windowtolayer vite build && electron .",
    "dev:electron:dist:sourcemap": "cross-env-shell ELECTRON_DEV=false ELECTRON=true NODE_OPTIONS=--enable-source-maps FOLIA_WINDOWTOLAYER_PATH=build/windowtolayer \"vite build --sourcemap && electron .\"",
    "dev:electron:dist:swiftshader": "cross-env ELECTRON_DEV=false ELECTRON=true ELECTRON_LINUX_PACKAGED_GRAPHICS=true FOLIA_LINUX_GRAPHICS_MODE=swiftshader FOLIA_WINDOWTOLAYER_PATH=build/windowtolayer vite build && electron .",
    "dev:electron:dist:software": "cross-env ELECTRON_DEV=false ELECTRON=true ELECTRON_LINUX_PACKAGED_GRAPHICS=true FOLIA_LINUX_GRAPHICS_MODE=software FOLIA_WINDOWTOLAYER_PATH=build/windowtolayer vite build && electron .",
    "build:electron:dir": "cross-env ELECTRON_DEV=false ELECTRON=true vite build && npm run build:windowtolayer && electron-builder --linux dir",
    "build:electron": "cross-env ELECTRON_DEV=false ELECTRON=true vite build && npm run build:windowtolayer && electron-builder",
    "build:windowtolayer": "node packaging/linux/build-windowtolayer.mjs",
    "contributors:add": "npx all-contributors-cli add",
    "contributors:generate": "npx all-contributors-cli generate",
    "models:fetch": "node build/fetchModels.mjs"
  },
  "build": {
    "appId": "top.izuna.foliamajor",
    "productName": "Folia",
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chthollyphile",
        "repo": "folia-major"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "build/miao.png",
      "build/thumbar/*.png"
    ],
    "asarUnpack": [
      "electron/analysis/htdemucs_runner.py"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.png",
        "to": "linux/icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "packaging/linux/folia-major.desktop",
        "to": "linux/folia-major.desktop"
      },
      {
        "from": "packaging/linux/README-LINUX.txt",
        "to": "linux/README-LINUX.txt"
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "windowtolayer",
          "windowtolayer-COPYING"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "target": [
        "tar.gz",
        "deb",
        "rpm"
      ],
      "publish": {
        "provider": "github",
        "publishAutoUpdate": false
      },
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "folia-major"
    }
  },
  "dependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@chenglou/pretext": "^0.0.8",
    "@google/genai": "^2.16.0",
    "@neteasecloudmusicapienhanced/api": "^4.40.1",
    "@paper-design/shaders-react": "^0.0.80",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xmldom/xmldom": "^0.9.10",
    "@yakult-green-tea/qq-music-api": "^3.1.0",
    "animejs": "^4.5.0",
    "axios": "^1.18.1",
    "blueimp-md5": "^2.19.0",
    "buffer": "^6.0.3",
    "busboy": "^1.6.0",
    "dexie": "^4.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "framer-motion": "^13.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "kugoumusicapi": "https://github.com/MakcRe/KuGouMusicApi/archive/refs/tags/v1.6.0.tar.gz",
    "lucide-react": "^1.31.0",
    "music-metadata": "^11.14.0",
    "onnxruntime-node": "^1.27.0",
    "opencc-js": "^1.4.1",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-window": "^2.3.0",
    "three": "^0.185.1",
    "twgl.js": "^7.0.0",
    "wanakana": "^5.3.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.13",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "7.29.7",
    "@discordjs/rest": {
      "undici": "^6.27.0"
    }
  }
}
