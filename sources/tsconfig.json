{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@folia/folium": ["../mods/folium.d.ts"],
      "@folia/folium-source-kit": ["../packages/folium-source-kit/src/index.ts"]
    }
  },
  "include": ["*/core/**/*", "*/client/**/*", "*/main/**/*"]
}
